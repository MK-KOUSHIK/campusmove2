# =====================================================================
# Campus Bus Tracker - Environment Configuration
# =====================================================================
# Copy this file to '.env' and fill in your Firebase project values.
# If you run 'npm run config' or 'node generate-config.js', these values
# will automatically populate 'firebase-config.js'.
# =====================================================================

# ---------------------------------------------------------------------
# Firebase Web App Credentials
# Obtain these from: Firebase Console > Project Settings > General > Your Apps > Web App
# ---------------------------------------------------------------------
FIREBASE_API_KEY="AIzaSyYourApiKeyHere"
FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
FIREBASE_DATABASE_URL="https://your-project-id-default-rtdb.firebaseio.com"
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
FIREBASE_MESSAGING_SENDER_ID="123456789012"
FIREBASE_APP_ID="1:123456789012:web:abcdef123456"

# ---------------------------------------------------------------------
# Campus Transit & Geofence Settings (Optional)
# ---------------------------------------------------------------------
# Distance in meters within which student attendance is automatically marked
GEOFENCE_RADIUS_METERS=20

# Default center point for Leaflet map (latitude, longitude)
CAMPUS_CENTER_LAT=12.9716
CAMPUS_CENTER_LNG=77.5946

